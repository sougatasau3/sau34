                "html": "<style>.kec-nav{display:flex;align-items:center;justify-content:space-between;gap:1.5rem;max-width:1320px;margin:0 auto;min-height:44px;font-family:'Jost',sans-serif}.kec-nav-logo{display:flex;flex-direction:column;text-decoration:none}.kec-nav-logo .logo-main{font-family:'Fraunces',Georgia,serif;font-size:1.5rem;font-weight:700;color:#1C1A16;letter-spacing:-0.5px;line-height:1}.kec-nav-logo .logo-main span{color:#C8851A;font-style:italic}.kec-nav-logo .logo-sub{font-size:0.58rem;color:#6B6355;font-weight:400;letter-spacing:1px;text-transform:uppercase;margin-top:2px}.kec-nav-links{list-style:none;display:flex;align-items:center;gap:2.2rem;padding:0;margin:0}.kec-nav-links a{font-size:0.82rem;font-weight:500;color:#6B6355;text-decoration:none;transition:color 0.2s}.kec-nav-links a:hover{color:#1C1A16}.kec-nav-right{display:flex;align-items:center;gap:0.7rem}.kec-btn-call{display:flex;align-items:center;gap:5px;font-size:0.8rem;font-weight:600;color:#1A3D6B;border:1.5px solid #E8EFF8;padding:7px 16px;border-radius:100px;text-decoration:none;transition:all 0.2s;white-space:nowrap}.kec-btn-call:hover{background:#E8EFF8}.kec-btn-wa{background:#25D366;color:#fff;padding:9px 22px;border-radius:100px;font-size:0.82rem;font-weight:600;display:flex;align-items:center;gap:6px;text-decoration:none;transition:all 0.2s;white-space:nowrap}.kec-btn-wa:hover{background:#128C7E;transform:translateY(-1px)}.kec-hamburger{display:none;flex-direction:column;justify-content:center;align-items:center;width:36px;height:36px;cursor:pointer;border:none;background:none;padding:0;gap:5px;z-index:1001}.kec-hamburger span{display:block;width:22px;height:2.5px;background:#1C1A16;border-radius:2px;transition:all 0.3s ease}.kec-hamburger:hover{background:#1A3D6B;border-radius:8px}.kec-hamburger:hover span{background:#ffffff}.kec-hamburger.active{background:#1A3D6B;border-radius:8px}.kec-hamburger.active span{background:#ffffff}.kec-hamburger.active span:nth-child(1){transform:rotate(45deg) translate(5px,5px)}.kec-hamburger.active span:nth-child(2){opacity:0}.kec-hamburger.active span:nth-child(3){transform:rotate(-45deg) translate(5px,-5px)}.kec-mobile-menu{display:none;position:fixed;top:0;left:0;width:100%;height:100vh;background:rgba(253,250,245,0.98);backdrop-filter:blur(20px);z-index:1000;flex-direction:column;align-items:center;justify-content:center;gap:2rem;opacity:0;visibility:hidden;transition:all 0.3s ease}.kec-mobile-menu.open{opacity:1;visibility:visible}.kec-mobile-menu a{font-family:'Jost',sans-serif;font-size:1.4rem;font-weight:500;color:#1C1A16;text-decoration:none;padding:8px 0;transition:color 0.2s}.kec-mobile-menu a:hover{color:#C8851A}.kec-mobile-menu .kec-mobile-wa{background:#25D366;color:#fff;padding:14px 32px;border-radius:100px;font-size:1rem;font-weight:600;display:inline-flex;align-items:center;gap:8px;margin-top:1rem;box-shadow:0 6px 24px rgba(37,211,102,0.3)}.kec-mobile-menu .kec-mobile-wa:hover{background:#128C7E;color:#fff}.kec-mobile-menu .kec-mobile-call{font-size:0.9rem;color:#1A3D6B;font-weight:600;border:1.5px solid #E8EFF8;padding:10px 24px;border-radius:100px;margin-top:0.5rem}@media(max-width:920px){.kec-nav-links{display:none}.kec-btn-call{display:none}.kec-hamburger{display:flex}.kec-mobile-menu{display:flex}}@media(max-width:600px){.kec-nav-right .kec-btn-wa{display:none}}@media(max-width:600px){.kec-nav-logo .logo-main{font-size:1.2rem}}</style><nav class=\"kec-nav\"><a href=\"#home\" class=\"kec-nav-logo\"><span class=\"logo-main\">Kolkata<span>Elder</span>Care</span><span class=\"logo-sub\">CMIG Gerontology · Est. 2024</span></a><ul class=\"kec-nav-links\"><li><a href=\"#home\">Home</a></li><li><a href=\"#about\">About</a></li><li><a href=\"#services\">Services</a></li><li><a href=\"#pricing\">Plans</a></li><li><a href=\"#doctors\">Our Team</a></li><li><a href=\"#contact\">Contact</a></li></ul><div class=\"kec-nav-right\"><a href=\"tel:+917288818181\" class=\"kec-btn-call\">📞 Call India</a><a href=\"https://wa.me/917288818181?text=Hi%2C+I+want+to+book+elder+care+for+my+parents\" target=\"_blank\" class=\"kec-btn-wa\">📲 WhatsApp</a><button class=\"kec-hamburger\" onclick=\"document.querySelector('.kec-mobile-menu').classList.toggle('open');this.classList.toggle('active');\" aria-label=\"Menu\"><span></span><span></span><span></span></button></div></nav><div class=\"kec-mobile-menu\"><a href=\"#home\" onclick=\"document.querySelector('.kec-mobile-menu').classList.remove('open');document.querySelector('.kec-hamburger').classList.remove('active');\">Home</a><a href=\"#about\" onclick=\"document.querySelector('.kec-mobile-menu').classList.remove('open');document.querySelector('.kec-hamburger').classList.remove('active');\">About</a><a href=\"#services\" onclick=\"document.querySelector('.kec-mobile-menu').classList.remove('open');document.querySelector('.kec-hamburger').classList.remove('active');\">Services</a><a href=\"#pricing\" onclick=\"document.querySelector('.kec-mobile-menu').classList.remove('open');document.querySelector('.kec-hamburger').classList.remove('active');\">Plans</a><a href=\"#doctors\" onclick=\"document.querySelector('.kec-mobile-menu').classList.remove('open');document.querySelector('.kec-hamburger').classList.remove('active');\">Our Team</a><a href=\"#contact\" onclick=\"document.querySelector('.kec-mobile-menu').classList.remove('open');document.querySelector('.kec-hamburger').classList.remove('active');\">Contact</a><a href=\"https://wa.me/917288818181?text=Hi%2C+I+want+to+book+elder+care+for+my+parents\" target=\"_blank\" class=\"kec-mobile-wa\">📲 WhatsApp Us</a><a href=\"tel:+917288818181\" class=\"kec-mobile-call\">📞 Call India</a></div><script>document.querySelectorAll('a[href^=\"#\"]').forEach(function(a){a.addEventListener('click',function(e){var t=document.querySelector(a.getAttribute('href'));if(t){e.preventDefault();t.scrollIntoView({behavior:'smooth',block:'start'})}})});</script>"
