              "settings": {
                "html": "<style>.kec-nav{display:flex;align-items:center;justify-content:space-between;gap:1.5rem;max-width:1320px;margin:0 auto;min-height:44px;font-family:'Jost',sans-serif}.kec-nav-logo{display:flex;flex-direction:column;text-decoration:none}.kec-nav-logo .logo-main{font-family:'Fraunces',Georgia,serif;font-size:1.5rem;font-weight:700;color:#1C1A16;letter-spacing:-0.5px;line-height:1}.kec-nav-logo .logo-main span{color:#C8851A;font-style:italic}.kec-nav-logo .logo-sub{font-size:0.58rem;color:#6B6355;font-weight:400;letter-spacing:1px;text-transform:uppercase;margin-top:2px}.kec-nav-links{list-style:none;display:flex;align-items:center;gap:2.2rem;padding:0;margin:0}.kec-nav-links a{font-size:0.82rem;font-weight:500;color:#6B6355;text-decoration:none;transition:color 0.2s}.kec-nav-links a:hover{color:#1C1A16}.kec-nav-right{display:flex;align-items:center;gap:0.7rem}.kec-btn-call{display:flex;align-items:center;gap:5px;font-size:0.8rem;font-weight:600;color:#1A3D6B;border:1.5px solid #E8EFF8;padding:7px 16px;border-radius:100px;text-decoration:none;transition:all 0.2s;white-space:nowrap}.kec-btn-call:hover{background:#E8EFF8}.kec-btn-wa{background:#25D366;color:#fff;padding:9px 22px;border-radius:100px;font-size:0.82rem;font-weight:600;display:flex;align-items:center;gap:6px;text-decoration:none;transition:all 0.2s;white-space:nowrap}.kec-btn-wa:hover{background:#128C7E;transform:translateY(-1px)}@media(max-width:920px){.kec-nav-links{display:none}}@media(max-width:600px){.kec-btn-call{display:none}.kec-nav-logo .logo-main{font-size:1.2rem}}</style><nav class=\"kec-nav\"><a href=\"#home\" class=\"kec-nav-logo\"><span class=\"logo-main\">Kolkata<span>Elder</span>Care</span><span class=\"logo-sub\">CMIG Gerontology · Est. 2024</span></a><ul class=\"kec-nav-links\"><li><a href=\"#about\">About</a></li><li><a href=\"#services\">Services</a></li><li><a href=\"#pricing\">Plans</a></li><li><a href=\"#doctors\">Our Team</a></li><li><a href=\"#contact\">Contact</a></li></ul><div class=\"kec-nav-right\"><a href=\"tel:+917288818181\" class=\"kec-btn-call\">📞 Call India</a><a href=\"https://wa.me/917288818181?text=Hi%2C+I+want+to+book+elder+care+for+my+parents\" target=\"_blank\" class=\"kec-btn-wa\">📲 WhatsApp Us</a></div></nav>"
