und:#C0E0CC}.kec-doc-av.c{background:#F0D8C8}.kec-doc-av.d{background:#F0D098}.kec-doc-body{padding:2.2rem 1.4rem 1.4rem;text-align:center}.kec-doc-name{font-family:'Fraunces',serif;font-size:1.05rem;font-weight:700;color:#1C1A16;margin-bottom:.25rem}.kec-doc-spec{font-size:.75rem;color:#C8851A;font-weight:600;margin-bottom:.4rem}.kec-doc-quote{font-size:.75rem;color:#6B6355;font-style:italic;line-height:1.6;margin-bottom:.7rem;padding:0 .4rem}.kec-doc-meta{display:flex;justify-content:center;gap:.8rem;margin:.5rem 0;flex-wrap:wrap}.kec-doc-meta span{font-size:.68rem;color:#A89880;display:flex;align-items:center;gap:3px}.kec-doc-stars{color:#C8851A;font-size:.72rem;letter-spacing:1px;margin-bottom:.3rem}.kec-doc-lang{font-size:.7rem;color:#6B6355;display:block;margin-bottom:.8rem}.kec-doc-wa{display:flex;align-items:center;justify-content:center;gap:5px;width:100%;padding:9px;background:#25D366;color:#fff;border-radius:10px;font-size:.75rem;font-weight:600;text-decoration:none;transition:background .2s}.kec-doc-wa:hover{background:#128C7E}@media(max-width:920px){.kec-docs-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.kec-docs-grid{grid-template-columns:1fr}.kec-docs-header{flex-direction:column;align-items:flex-start}}</style><div class=\"kec-docs\"><div class=\"kec-docs-header\"><div><span class=\"kec-docs-label\">Our Medical Team</span><h2 class=\"kec-docs-title\">Doctors Who Speak<br>Your Language. <em>And Listen.</em></h2><p class=\"kec-docs-sub\">Every doctor is MCI/NMC registered. CMIG certified gerontologists on team. Registration numbers shown publicly.</p></div><a href=\"https://wa.me/917288818181?text=Hi%2C+I+want+to+consult+a+doctor\" target=\"_blank\" class=\"kec-docs-cta\">📲 Book a Consultation</a></div><div class=\"kec-docs-grid\"><div class=\"kec-doc-card\"><div class=\"kec-doc-top a\"><div class=\"kec-doc-av a\">দে</div></div><div class=\"kec-doc-body\"><div class=\"kec-doc-name\">Dr. Debasmita Roy</div><div class=\"kec-doc-spec\">General Physician · MBBS, MD</div><div class=\"kec-doc-quote\">\"I explain slowly. In your language. Until you fully understand.\"</div><div class=\"kec-doc-meta\"><span>⏱ 12 years</span><span>📋 MCI: 2341-WB</span></div><div class=\"kec-doc-stars\">★★★★★</div><span class=\"kec-doc-lang\">Bengali · Hindi · English</span><a href=\"https://wa.me/917288818181?text=Hi%2C+I+want+to+consult+Dr.+Debasmita+Roy\" target=\"_blank\" class=\"kec-doc-wa\">📲 Book — ₹199</a></div></div><div class=\"kec-doc-card\"><div class=\"kec-doc-top b\"><div class=\"kec-doc-av b\">সু</div></div><div class=\"kec-doc-body\"><div class=\"kec-doc-name\">Dr. Subrata Ghosh</div><div class=\"kec-doc-spec\">Geriatrician · MBBS, MD · CMIG</div><div class=\"kec-doc-quote\">\"Elders deserve patience. I have all the time in the world for them.\"</div><div class=\"kec-doc-meta\"><span>⏱ 18 years</span><span>📋 MCI: 1892-WB</span></div><div class=\"kec-doc-stars\">★★★★★</div><span class=\"kec-doc-lang\">Bengali · English</span><a href=\"https://wa.me/917288818181?text=Hi%2C+I+want+to+consult+Dr.+Subrata+Ghosh\" target=\"_blank\" class=\"kec-doc-wa\">📲 Book — ₹299</a></div></div><div class=\"kec-doc-card\"><div class=\"kec-doc-top c\"><div class=\"kec-doc-av c\">প্র</div></div><div class=\"kec-doc-body\"><div class=\"kec-doc-name\">Dr. Priya Mukherjee</div><div class=\"kec-doc-spec\">Diabetologist · MBBS, MD, DNB</div><div class=\"kec-doc-quote\">\"Managing diabetes is a partnership. I am your partner for life.\"</div><div class=\"kec-doc-meta\"><span>⏱ 9 years</span><span>📋 MCI: 3108-WB</span></div><div class=\"kec-doc-stars\">★★★★★</div><span class=\"kec-doc-lang\">Bengali · Hindi</span><a href=\"https://wa.me/917288818181?text=Hi%2C+I+want+to+consult+Dr.+Priya+Mukherjee\" target=\"_blank\" class=\"kec-doc-wa\">📲 Book — ₹249</a></div></div><div class=\"kec-doc-card\"><div class=\"kec-doc-top d\"><div class=\"kec-doc-av d\">রা</div></div><div class=\"kec-doc-body\"><div class=\"kec-doc-name\">Dr. Rajib Sen